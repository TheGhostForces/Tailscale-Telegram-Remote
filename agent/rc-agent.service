[Unit]
Description=Remote control agent
After=graphical-session.target
PartOf=graphical-session.target

[Service]
WorkingDirectory=%h/.local/share/rc-agent
ExecStart=%h/.local/share/rc-agent/venv/bin/python agent.py
Restart=always
RestartSec=5
NoNewPrivileges=yes

[Install]
WantedBy=graphical-session.target
