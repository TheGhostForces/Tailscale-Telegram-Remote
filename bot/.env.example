# Секреты бота. Скопируйте в .env, права 600. НЕ коммитить.
BOT_TOKEN=123456:ABC...            # токен от @BotFather
OWNER_ID=123456789                 # ваш числовой Telegram ID (узнать у @userinfobot)
TOTP_SECRET=                       # python gen_totp.py
# Секреты агентов здесь больше не нужны: они хранятся в devices.yaml (ведётся rcctl).
